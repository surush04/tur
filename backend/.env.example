# Local development only. Change every secret before any shared or production deployment.
DATABASE_URL=postgresql://rohi:rohi_dev_password@localhost:5432/rohi_travel?schema=public
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# Usual local port. The Angular apps call this port. Change PORT and both environment.ts apiUrl values together.
# This workspace uses 3010 because port 3000 was already taken by another local application.
PORT=3010
CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://127.0.0.1:4200,http://127.0.0.1:4201
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
SEED_ADMIN_PASSWORD=RohiAdmin!234
SEED_DEMO_PASSWORD=Traveler!234
UPLOAD_DIR=uploads
